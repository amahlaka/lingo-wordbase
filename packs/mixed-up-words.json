    {"id":"rob-steal","type":"confusable","title":{"en":"rob or steal","fi":"rob vai steal"},"explanation":{"en":"You steal a thing: Someone stole my bike. You rob a person or a place: Two men robbed a bank. So your phone is stolen, but you are robbed.","fi":"*Steal* = varastaa, ja sen kohde on tavara: *Someone stole my bike*. *Rob* = ryöstää, ja sen kohde on ihminen tai paikka: *Two men robbed a bank*. Puhelin siis on *stolen*, mutta ihminen on *robbed*."},"level":2,"words":[{"text":"rob","meaning":{"fi":"ryöstää (ihminen tai paikka)"}},{"text":"steal","meaning":{"fi":"varastaa (tavara)"}}],"features":["confusable","irregular-verb","passive"]},
